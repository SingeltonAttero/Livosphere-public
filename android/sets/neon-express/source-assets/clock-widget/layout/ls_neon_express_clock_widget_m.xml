<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/clock_widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:padding="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/ls_neon_express_clock_widget_background" android:gravity="center" android:orientation="vertical" android:padding="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <TextClock android:id="@+id/clock_widget_time" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:background="@drawable/ls_neon_express_clock_widget_cell" android:fontFamily="@font/ls_neon_express_clock_widget_space_mono_bold"
                android:format12Hour="h" android:format24Hour="HH" android:gravity="center" android:includeFontPadding="false"
                android:singleLine="true" android:textColor="#F3C789" android:textSize="46sp" />
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:layout_weight="1"
                android:background="@drawable/ls_neon_express_clock_widget_cell">
                <TextClock android:id="@+id/clock_widget_minutes" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:fontFamily="@font/ls_neon_express_clock_widget_space_mono_bold" android:format12Hour="mm" android:format24Hour="mm"
                    android:gravity="center" android:includeFontPadding="false" android:singleLine="true" android:textColor="#F3C789" android:textSize="46sp" />
                <TextClock android:id="@+id/clock_widget_period" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="end|bottom" android:layout_marginEnd="4dp" android:layout_marginBottom="2dp"
                    android:fontFamily="@font/ls_neon_express_clock_widget_space_mono_bold" android:format12Hour="a" android:format24Hour=" "
                    android:includeFontPadding="false" android:singleLine="true" android:textColor="#F3C789" android:textSize="8sp" />
            </FrameLayout>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="2dp" android:layout_marginTop="5dp" android:background="#B79ADD" />
        <TextClock android:id="@+id/clock_widget_date" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:fontFamily="sans-serif" android:format12Hour="EEE, d MMMM" android:format24Hour="EEE, d MMMM"
            android:gravity="center" android:includeFontPadding="false" android:letterSpacing="0.08" android:singleLine="true"
            android:textAllCaps="true" android:textColor="#F3C789" android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
