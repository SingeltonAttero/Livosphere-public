<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock_widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/ls_orbital_window_clock_widget_background" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center"
        android:orientation="vertical">
        <AnalogClock android:id="@+id/clock_widget_analog" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:dial="@drawable/ls_orbital_window_clock_widget_dial"
            android:hand_hour="@drawable/ls_orbital_window_clock_widget_hour_hand"
            android:hand_minute="@drawable/ls_orbital_window_clock_widget_minute_hand" />
        <TextClock android:id="@+id/clock_widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
            android:layout_marginTop="6dp" android:fontFamily="sans-serif" android:format12Hour="EEE, d MMMM" android:format24Hour="EEE, d MMMM"
            android:includeFontPadding="false" android:singleLine="true" android:textAllCaps="true" android:textColor="#E5F1EF" android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
