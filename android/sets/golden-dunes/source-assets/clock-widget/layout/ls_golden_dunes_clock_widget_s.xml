<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock_widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/ls_golden_dunes_clock_widget_background_s" android:gravity="center" android:orientation="vertical" android:padding="12dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <TextClock android:id="@+id/clock_widget_time" android:layout_width="match_parent" android:layout_height="match_parent"
                android:fontFamily="@font/ls_golden_dunes_clock_widget_cormorant_garamond_family" android:format12Hour="h" android:format24Hour="HH"
                android:gravity="center" android:includeFontPadding="false" android:singleLine="true" android:textColor="#62432D" android:textSize="52sp" />
            <TextClock android:id="@+id/clock_widget_period" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="end|bottom" android:fontFamily="sans-serif" android:format12Hour="a" android:format24Hour=" "
                android:includeFontPadding="false" android:singleLine="true" android:textColor="#62432D" android:textSize="8sp" />
        </FrameLayout>
        <TextClock android:id="@+id/clock_widget_minutes" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:fontFamily="@font/ls_golden_dunes_clock_widget_cormorant_garamond_family" android:format12Hour="mm" android:format24Hour="mm"
            android:gravity="center" android:includeFontPadding="false" android:singleLine="true" android:textColor="#62432D" android:textSize="52sp" />
    </LinearLayout>
</FrameLayout>
