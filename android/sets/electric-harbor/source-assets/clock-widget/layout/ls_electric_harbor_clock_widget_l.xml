<?xml version="1.0" ?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/clock_widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="4dp">
    <LinearLayout android:id="@+id/clock_widget_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:background="@drawable/ls_electric_harbor_clock_widget_bg_l" android:padding="12dp" android:orientation="vertical" android:gravity="center">
        <TextClock android:id="@+id/clock_widget_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:fontFamily="monospace" android:textColor="#E4FBFF" android:textSize="76sp" android:includeFontPadding="false" android:singleLine="true" android:format12Hour="h:mm" android:format24Hour="HH:mm" android:textStyle="bold"/>
        <TextClock android:id="@+id/clock_widget_weekday" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:fontFamily="sans-serif" android:textColor="#C0D9E1" android:textSize="16sp" android:includeFontPadding="false" android:singleLine="true" android:format12Hour="EEEE" android:format24Hour="EEEE" android:layout_marginTop="8dp"/>
        <TextClock android:id="@+id/clock_widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:fontFamily="sans-serif" android:textColor="#E4FBFF" android:textSize="16sp" android:includeFontPadding="false" android:singleLine="true" android:format12Hour="d MMMM" android:format24Hour="d MMMM" android:layout_marginTop="2dp"/>
    </LinearLayout>
</FrameLayout>
