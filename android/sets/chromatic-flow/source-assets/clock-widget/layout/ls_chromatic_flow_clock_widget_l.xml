<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock_widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/ls_chromatic_flow_clock_widget_background" android:gravity="center" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="4dp" android:gravity="center" android:orientation="horizontal">
            <TextView android:layout_width="60dp" android:layout_height="4dp" android:background="#4D9D9A" />
            <TextView android:layout_width="24dp" android:layout_height="4dp" android:layout_marginStart="4dp" android:background="#D29448" />
            <TextView android:layout_width="16dp" android:layout_height="4dp" android:layout_marginStart="4dp" android:background="#F2E4C9" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="8dp" android:layout_weight="1" android:gravity="center" android:orientation="horizontal">
            <TextClock android:id="@+id/clock_widget_time" android:layout_width="wrap_content" android:layout_height="match_parent"
                android:fontFamily="@font/ls_chromatic_flow_clock_widget_anton" android:format12Hour="h:mm" android:format24Hour="HH:mm"
                android:gravity="center" android:includeFontPadding="false" android:singleLine="true" android:textColor="#FAEDD3" android:textSize="100sp" />
            <TextClock android:id="@+id/clock_widget_period" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="bottom" android:layout_marginStart="3dp" android:layout_marginBottom="10dp" android:fontFamily="sans-serif"
                android:format12Hour="a" android:format24Hour=" " android:includeFontPadding="false" android:singleLine="true" android:textColor="#FAEDD3" android:textSize="10sp" />
        </LinearLayout>
        <TextClock android:id="@+id/clock_widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:fontFamily="sans-serif" android:format12Hour="EEE, d MMMM" android:format24Hour="EEE, d MMMM" android:gravity="center"
            android:includeFontPadding="false" android:singleLine="true" android:textAllCaps="true" android:textColor="#FAEDD3" android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
