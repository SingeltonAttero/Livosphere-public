# Copy to an ignored .env only for owner-signed candidates.
# Literal values after =; do not add quotes or export.
# Absolute keystore path outside this checkout; debug builds do not need it.
LIVOSPHERE_RELEASE_KEYSTORE=/absolute/path/outside-checkout/livosphere-upload.jks
LIVOSPHERE_RELEASE_KEY_ALIAS=livosphere-upload
LIVOSPHERE_RELEASE_STORE_PASSWORD=
LIVOSPHERE_RELEASE_KEY_PASSWORD=
LIVOSPHERE_RELEASE_CERT_SHA256=
LIVOSPHERE_OWNER_KEY_CONFIRMED=no
PRODUCT_RELEASE=1.0.0
PHONE_PREVIOUS_VERSION_CODE=0
PHONE_VERSION_CODE=1
# LIVOSPHERE_EVIDENCE_DIR=/absolute/path/to/private-evidence
# LIVOSPHERE_RELEASE_RUN_DIR=.local/evidence/phone-v2/<run-id>
